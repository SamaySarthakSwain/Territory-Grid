rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Initial development rules - strictly replaced and hardened in Phase 6
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /game/state {
      allow read, write: if request.auth != null;
    }
    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }
    match /clues/{clueId} {
      allow read, write: if request.auth != null;
    }
    match /checkins/{checkinId} {
      allow read, write: if request.auth != null;
    }
  }
}
